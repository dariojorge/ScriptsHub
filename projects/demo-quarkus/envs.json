{
  "envs": [
    {
      "type": "quarkus",
      "envVars": []
    },
    {
      "type": "test",
      "envVars": [
        {
          "key": "DEMO_MESSAGE_01",
          "value": "This message is a message from test."
        },
        {
          "key": "DEMO_MESSAGE_02",
          "value": "When this is a message for test."
        },
        {
          "key": "DEMO_MESSAGE_03",
          "value": "Why message? From test."
        }
      ]
    },
    {
      "type": "test-without-message-2",
      "envVars": [
        {
          "key": "DEMO_MESSAGE_01",
          "value": "This message is a message on second environment config from test-without-message-2."
        },
        {
          "key": "DEMO_MESSAGE_03",
          "value": "Why message on second environment config? From test-without-message-2."
        }
      ]
    },
    {
      "type": "test-without-message-3",
      "envVars": [
        {
          "key": "DEMO_MESSAGE_01",
          "value": "This message is a message on third environment config from test-without-message-3."
        },
        {
          "key": "DEMO_MESSAGE_02",
          "value": "When this is a message on third environment config for test-without-message-3."
        }
      ]
    },
    {
      "type": "test-without-message-2-and-3",
      "envVars": [
        {
          "key": "DEMO_MESSAGE_01",
          "value": "This message is a message on forth environment config from test-without-message-2-and-3."
        }
      ]
    }
  ],
  "additionalScripts": [
    {
      "name": "readEnvScript",
      "filePath": "../demo-quarkus/demoExamples/demoEnvs.txt",
      "script": "../additionalScripts/readEnvScript.js",
      "regexSearch": "{ORIGIN}=.*",
      "regexReplace": ".*=",
      "envVars": [
        {
          "key": "DEMO_MESSAGE_01",
          "origin": "demoMessage01"
        },
        {
          "key": "DEMO_MESSAGE_02",
          "origin": "demoMessage02"
        }
      ]
    },
    {
      "name": "envSpecifics",
      "script": "../additionalScripts/additionalEnvSpecific.js",
      "envVars": [
        {
          "key": "DEMO_MESSAGE_03",
          "value": "Why message on the execute additionalEnvs?"
        }
      ]
    }
  ],
  "additionalCmd": [
    {
      "type": "arg",
      "value": "showDemoEnvsContent",
      "cmd": "cat ../demo-quarkus/demoExamples/demoEnvs.txt"
    },
    {
      "type": "execute",
      "value": "true",
      "cmd": "ls ../demo-quarkus/demoExamples"
    },
    {
      "type": "arg",
      "value": "openIntellij",
      "cmd": "node scripts/utils/openIntellij.js project=projectLabel"
    }
  ],
  "additionalData": [
    {
      "type": "WORKING_ENV",
      "envVars": ["test-without-message-2-and-3"]
    }
  ]
}
